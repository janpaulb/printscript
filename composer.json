{
    "name": "janpaulb/printscript",
    "description": "Google Docs of Word erin, drukklare PDF eruit.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "ext-dom": "*",
        "ext-libxml": "*",
        "ext-mbstring": "*",
        "ext-zip": "*",
        "mpdf/mpdf": "^8.2"
    },
    "suggest": {
        "ext-curl": "Nodig om documenten bij Google Docs op te halen.",
        "ext-gd": "Nodig voor afbeeldingen in de PDF."
    },
    "autoload": {
        "psr-4": {
            "PrintScript\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PrintScript\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "scripts": {
        "test": "vendor-dev/bin/phpunit"
    }
}
